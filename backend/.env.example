# Plantilla de variables de entorno del backend (coffee-system).
# Copia este archivo a `backend/.env` y rellena con los valores REALES de Supabase.
# `backend/.env` está en .gitignore: NUNCA se commitea (contiene secretos).
# application.yaml las lee vía `spring.config.import: optional:file:.env`.

# --- Base de datos (PostgreSQL en Supabase) ---
# Saca el host de Supabase: botón "Connect" -> pestaña "JDBC" -> "Session pooler".
# IMPORTANTE: la URL lleva SOLO host, puerto y base de datos.
#   - Debe empezar con `jdbc:` (usa la pestaña JDBC, NO la "URI").
#   - El usuario y la contraseña van SIEMPRE aparte (DB_USERNAME / DB_PASSWORD),
#     nunca dentro de la URL.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# Usuario del pooler: postgres.<project-ref> (lo da la misma pantalla de Connect).
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<tu-password-de-la-base-de-datos>

# --- JWT ---
# Secreto para firmar los tokens de tu backend (NO es la API key de Supabase).
# Se usa como bytes crudos: debe tener al menos 32 caracteres.
# Genera uno propio, p. ej.: openssl rand -hex 48
JWT_SECRET=<tu-secreto-jwt-aleatorio>
# Expiración del token en milisegundos (opcional; por defecto 86400000 = 24h).
JWT_EXPIRATION=86400000
